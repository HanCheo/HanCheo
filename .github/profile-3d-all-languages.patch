+const BASE_PIE_WIDTH = 1200;
+const MAX_COLUMNS = 3;
+const MAX_FONT_SIZE = 22;
+
+export interface PieLanguageLayout {
+    width: number;
+    height: number;
+    columns: number;
+    rows: number;
+    fontSize: number;
+    columnWidth: number;
+}
+
+export const getPieLanguageLayout = (
+    languageNames: string[]
+): PieLanguageLayout => {
+    const count = Math.max(1, languageNames.length);
+    const fontSize = MAX_FONT_SIZE;
+    const longestName = Math.max(
+        1,
+        ...languageNames.map((language) => language.length)
+    );
+    const labelWidth = longestName * fontSize * 0.62 + fontSize * 2.2;
+    const availableWidth = BASE_PIE_WIDTH - PIE_RADIUS * 2.1;
+    const columns = Math.max(
+        1,
+        Math.min(MAX_COLUMNS, Math.floor(availableWidth / labelWidth))
+    );
+    const rows = Math.ceil(count / columns);
+    const columnWidth = availableWidth / columns;
+    return {
+        width: Math.max(
+            BASE_PIE_WIDTH,
+            PIE_RADIUS * 2.1 + columns * labelWidth + 20
+        ),
+        height: Math.max(BASE_PIE_HEIGHT, rows * fontSize * 1.5 + 20),
+        columns,
+        rows,
+        fontSize,
+        columnWidth,
+    };
+};
 
